{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git remote)",
      "Bash(git remote -v)",
      "Bash(git branch --list)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git grep *)",
      "Bash(git ls-tree *)",
      "Bash(git rev-parse *)",
      "Bash(git switch main)",
      "Bash(git pull --ff-only)",
      "Bash(git fetch --depth 1 *)",
      "Bash(git switch -c sync/*)",
      "Bash(git rm -r -q --ignore-unmatch requirements)",
      "Bash(git mv docs/requirements requirements)",
      "Bash(git mv docs/product.md requirements/product.md)",
      "Bash(git add requirements)",
      "Bash(git add requirements docs/conformance.md)",
      "Bash(gh repo view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(npm run spec:validate)",
      "Bash(npm run spec:check)",
      "Bash(npm run ac:coverage)",
      "PowerShell(git status *)",
      "PowerShell(git remote)",
      "PowerShell(git remote -v)",
      "PowerShell(git branch --list)",
      "PowerShell(git log *)",
      "PowerShell(git diff *)",
      "PowerShell(git show *)",
      "PowerShell(git grep *)",
      "PowerShell(git ls-tree *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git switch main)",
      "PowerShell(git pull --ff-only)",
      "PowerShell(git fetch --depth 1 *)",
      "PowerShell(git switch -c sync/*)",
      "PowerShell(git rm -r -q --ignore-unmatch requirements)",
      "PowerShell(git mv docs/requirements requirements)",
      "PowerShell(git mv docs/product.md requirements/product.md)",
      "PowerShell(git add requirements)",
      "PowerShell(git add requirements docs/conformance.md)",
      "PowerShell(gh repo view *)",
      "PowerShell(gh issue list *)",
      "PowerShell(gh issue view *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr diff *)",
      "PowerShell(npm run spec:validate)",
      "PowerShell(npm run spec:check)",
      "PowerShell(npm run ac:coverage)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(product/denylist.local*)",
      "Bash(*supabase db push*)",
      "Bash(*supabase db reset*--linked*)",
      "Bash(*supabase db reset*--db-url*)",
      "Bash(*supabase migration down*--linked*)",
      "Bash(*supabase migration repair*)",
      "PowerShell(*supabase db push*)",
      "PowerShell(*supabase db reset*--linked*)",
      "PowerShell(*supabase db reset*--db-url*)",
      "PowerShell(*supabase migration down*--linked*)",
      "PowerShell(*supabase migration repair*)"
    ]
  }
}
