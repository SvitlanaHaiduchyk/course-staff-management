# Скопіюйте у .env.local (він у .gitignore) і заповніть значеннями з вашого проєкту Supabase:
# Project Settings → API Keys (точну назву розділу перевірте в інтерфейсі). Значення ніколи не комітимо й не вставляємо в чат з агентом.

# Публічні (потрапляють у браузер; ці дві й лише ці — також у Vercel, Production і Preview):
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Лише скрипти (обходить RLS!), зараз — лише npm run users:demo. Ніколи з префіксом NEXT_PUBLIC_.
# У Vercel не додаємо ніколи:
SUPABASE_SECRET_KEY=sb_secret_...

# Один пароль для всіх синтетичних користувачів npm run users:demo (≥ 8 символів):
DEMO_USER_PASSWORD=

# Для Supabase MCP у Claude Code (.mcp.json читає змінну з оточення, а не з цього файлу):
# задайте її в терміналі перед запуском claude, напр. export SUPABASE_PROJECT_REF=<project-ref>
# SUPABASE_PROJECT_REF=

# AI-функція (зріз 4). Ваш ВЛАСНИЙ безкоштовний ключ OpenRouter: https://openrouter.ai/settings/keys
# Лише сервер: у .env.local і у Vercel (Production + Preview). Ніколи з префіксом NEXT_PUBLIC_
# (такі значення потрапляють у браузер), ніколи в git, логах чи чаті. Читає ключ лише src/lib/ai/openrouter.ts.
# Ліміт безкоштовних моделей — на акаунт: 20 запитів/хв і 50/день (його ділять усі, хто користується вашим застосунком).
OPENROUTER_API_KEY=

# Трекер помилок (WS11, трек B). DSN проєкту Sentry: Settings → Projects → <проєкт> → Client Keys (DSN).
# Це НЕ секрет: DSN лише приймає події, прочитати ним із Sentry нічого не можна, і він однаково
# потрапляє в код сторінки. Тому префікс NEXT_PUBLIC_ тут доречний — без нього помилки в браузері
# лишилися б невидимими. У Vercel — Production і Preview, одне значення на всі гілки.
# Порожнє значення = Sentry вимкнено (локальний запуск і тести нічого нікуди не шлють).
NEXT_PUBLIC_SENTRY_DSN=

# Необов'язково: назва середовища для подій Sentry з БРАУЗЕРА. Серверні події беруть APP_ENV,
# але в клієнтську збірку Next вшиває лише NEXT_PUBLIC_*. Без цього рядка помилки зі staging
# прийдуть із середовищем preview. У Vercel: Preview + Git Branch = staging, значення staging.
# NEXT_PUBLIC_APP_ENV=
