# Скопіюйте у .env.local (він у .gitignore) і заповніть значеннями з вашого проєкту Supabase:
# Project Settings → API Keys (точну назву розділу перевірте в інтерфейсі). Значення ніколи не комітимо й не вставляємо в чат з агентом.

# Публічні (потрапляють у браузер; ці дві й лише ці — також у Vercel, Production і Preview):
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Лише скрипти (обходить RLS!), зараз — лише npm run users:demo. Ніколи з префіксом NEXT_PUBLIC_.
# У Vercel не додаємо ніколи:
SUPABASE_SECRET_KEY=sb_secret_...

# Один пароль для всіх синтетичних користувачів npm run users:demo (≥ 8 символів):
DEMO_USER_PASSWORD=

# Для Supabase MCP у Claude Code (.mcp.json читає змінну з оточення, а не з цього файлу):
# задайте її в терміналі перед запуском claude, напр. export SUPABASE_PROJECT_REF=<project-ref>
# SUPABASE_PROJECT_REF=
