{
  "name": "2026-quitcode-06-project-template",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "spec:validate": "openspec validate --all --strict",
    "spec:check": "node scripts/check-spec.mjs",
    "ac:coverage": "node scripts/check-ac-coverage.mjs",
    "db:types": "supabase gen types typescript --linked > src/lib/supabase/database.types.ts",
    "users:demo": "node --env-file=.env.local scripts/create-demo-users.mjs",
    "positions:demo": "node --env-file=.env.local scripts/create-demo-positions.mjs",
    "closures:demo": "node --env-file=.env.local scripts/create-demo-closures.mjs",
    "lessons:demo": "node --env-file=.env.local scripts/create-demo-lessons.mjs",
    "check:design": "node scripts/check-design-tokens.mjs",
    "check:boundary": "node scripts/check-server-boundary.mjs",
    "carryover:demo": "node --env-file=.env.local scripts/create-demo-carryover.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:coverage": "vitest run --coverage --config vitest.coverage.config.mts",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "audit:dead": "fallow audit",
    "mutation:ts": "stryker run",
    "mutation:sql": "node scripts/mutation-check.mjs --kind sql",
    "uat": "node scripts/uat/run.mjs",
    "uat:nc": "node scripts/uat/run.mjs --negative-controls",
    "test:e2e": "playwright test",
    "accounts:zip": "node --env-file=.env.local scripts/zip-accounts.mjs",
    "shots:roles": "node scripts/role-screenshots.mjs docs/img",
    "eval": "vitest run -c vitest.eval.config.mts",
    "ai:models": "node scripts/free-models.mjs",
    "ai:quota": "node --env-file-if-exists=.env.local scripts/quota.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@sentry/nextjs": "^11.13.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "ai": "7.0.173",
    "cally": "0.9.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@fission-ai/openspec": "1.17.0",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-playwright": "^2.12.2",
    "fallow": "^3.43.2",
    "supabase": "2.122.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "24.x"
  }
}
