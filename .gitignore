# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# справжні назви клієнтів для npm run spec:check — лише локально (див. product/denylist.txt);
# зірочка ловить і denylist.local.txt.txt, якщо Провідник Windows приховав розширення
/product/denylist.local*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
